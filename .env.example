OPENROUTER_API_KEY=sk-or-...

# Провайдеры (openrouter | custom — любой OpenAI-совместимый endpoint)
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen3.8-27b
EMBED_PROVIDER=openrouter
EMBED_MODEL=qwen/qwen3-embedding-8b
# CUSTOM_BASE_URL=http://host:8000/v1
# CUSTOM_API_KEY=

# MAX_BOT_TOKEN=
# MAX_WEBHOOK_SECRET=

ADMIN_USER=hr
ADMIN_PASSWORD=change-me

# MAX: polling (разработка, публичный адрес не нужен) | webhook (прод: HTTPS:443 + MAX_WEBHOOK_SECRET)
# MAX_TRANSPORT=polling

# Контакт рекрутера — добавляется к ответу на кнопку «Связаться с рекрутером» (необязательно)
# RECRUITER_CONTACT=Рекрутер Мария: @maria_hr, +7 900 000-00-00

# Папка с базовыми документами (PDF, PPTX, DOCX, TXT, изображения): при старте попадают в базу знаний,
# убранные из папки — удаляются из неё. Документы, загруженные в панели вручную, остаются отдельно.
BASE_DOCS_DIR=./base_docs

# Удалять в MAX сообщение, под которым нажата кнопка (1 — да, 0 — оставлять; тогда кнопки только снимаются)
MAX_DELETE_PRESSED=1
